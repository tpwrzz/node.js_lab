<%- include('../partials/header', { title }) %>

    <h1>Добавить преподавателя</h1>

    <form action="/teachers" method="POST">
        <% if (errors && errors.length> 0) { %>
            <ul class="validation-errors">
                <% errors.forEach(error=> { %>
                    <li>
                        <%= error.msg || error %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <div>
                    <label for="name">Имя:</label>
                    <input type="text" id="name" name="name" value="<%= formData.name || '' %>" required>
                </div>

                <div>
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required>
                </div>

                <div>
                    <label for="department">Кафедра:</label>
                    <input type="text" id="department" name="department" value="<%= formData.department || '' %>"
                        required>
                </div>

                <div>
                    <label for="academicDegree">Учёная степень:</label>
                    <input type="text" id="academicDegree" name="academicDegree"
                        value="<%= formData.academicDegree || '' %>" required>
                </div>

                <button type="submit">Добавить</button>
    </form>

    <a href="/teachers">Назад к преподавателям</a>

    <%- include('../partials/footer') %>