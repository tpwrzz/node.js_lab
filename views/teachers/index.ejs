<%- include('../partials/header', { title }) %>

<h1>Преподаватели</h1>

<p>
    <a href="/teachers/new">Добавить преподавателя</a>
</p>

<% if (teachers.length === 0) { %>

    <p>Преподаватели не найдены</p>

<% } else { %>

    <table>
        <thead>
            <tr>
                <th>Имя</th>
                <th>Email</th>
                <th>Кафедра</th>
                <th>Учёная степень</th>
                <th>Количество курсов</th>
                <th>Действия</th>
            </tr>
        </thead>

        <tbody>
            <% teachers.forEach(teacher => { %>

                <tr>
                    <td>
                        <%= teacher.name %>
                    </td>

                    <td>
                        <%= teacher.email %>
                    </td>

                    <td>
                        <%= teacher.department %>
                    </td>

                    <td>
                        <%= teacher.academicDegree %>
                    </td>

                    <td>
                        <%= teacher.Courses.length %>
                    </td>

                    <td>
                        <a href="/teachers/<%= teacher.id %>">
                            Просмотр
                        </a>

                        <a href="/teachers/<%= teacher.id %>/edit">
                            Редактировать
                        </a>

                        <form
                            action="/teachers/<%= teacher.id %>/delete"
                            method="POST"
                            style="display: inline;"
                        >
                            <button type="submit">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>

            <% }) %>
        </tbody>
    </table>

<% } %>

<%- include('../partials/footer') %>