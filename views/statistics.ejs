<%- include('./partials/header', { title: 'Статистика библиотеки' }) %>

    <h1>Статистика библиотеки</h1>

    <h2>Общая статистика</h2>

    <ul>
        <li>Количество книг: <strong>
                <%= booksCount %>
            </strong></li>
        <li>Доступные книги: <strong>
                <%= availableBooksCount %>
            </strong></li>
        <li>Выданные книги: <strong>
                <%= takenBooksCount %>
            </strong></li>
        <li>Количество авторов: <strong>
                <%= authorsCount %>
            </strong></li>
        <li>Количество жанров: <strong>
                <%= genresCount %>
            </strong></li>
    </ul>

    <h2>Книги по жанрам</h2>

    <% if (booksByGenre.length===0) { %>
        <p>Данных о жанрах пока нет.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Жанр</th>
                        <th>Количество книг</th>
                    </tr>
                </thead>
                <tbody>
                    <% booksByGenre.forEach(genre=> { %>
                        <tr>
                            <td>
                                <%= genre.name %>
                            </td>
                            <td>
                                <%= genre.count %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <% } %>

                <h2>Книги по авторам</h2>

                <% if (booksByAuthor.length===0) { %>
                    <p>Данных об авторах пока нет.</p>
                    <% } else { %>
                        <table>
                            <thead>
                                <tr>
                                    <th>Автор</th>
                                    <th>Количество книг</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% booksByAuthor.forEach(author=> { %>
                                    <tr>
                                        <td>
                                            <%= author.name %>
                                        </td>
                                        <td>
                                            <%= author.count %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                        <% } %>

                            <h2>Автор с наибольшим количеством книг</h2>

                            <% if (authorWithMostBooks) { %>
                                <p>
                                    <strong>
                                        <%= authorWithMostBooks.name %>
                                    </strong>
                                    — <%= authorWithMostBooks.count %> книг(и)
                                </p>
                                <% } else { %>
                                    <p>Данных об авторах пока нет.</p>
                                    <% } %>

                                        <%- include('./partials/footer') %>