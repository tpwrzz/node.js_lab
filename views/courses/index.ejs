<%- include('../partials/header.ejs') -%>

<h1>Courses</h1>

<ul id="courses">
  <% courses.forEach(function(course) { %>
    <li>
      <h2><%= course.title %></h2>
      <p>Teacher: <%= course.teacher %></p>
      <p>Credits: <%= course.credits %></p>
      <p>Semester: <%= course.semester %></p>
      <p><%= course.description %></p>
    </li>
  <% }) %>
</ul>

<%- include('./partials/footer.ejs') -%>