<%- include('../partials/header') %>

<h1>Учебные курсы</h1>

<a href="/courses/new" class="button">Добавить новый курс</a>

<h2>Поиск и фильтрация</h2>

<form action="/courses" method="GET" class="filter-form">
    <div>
        <label for="search">Поиск:</label>
        <input
            type="text"
            id="search"
            name="search"
            value="<%= search || '' %>"
            placeholder="Название или преподаватель"
        >
    </div>

    <div>
        <label for="semester">Семестр:</label>
        <select id="semester" name="semester">
            <option value="">Все семестры</option>

            <% for (let i = 1; i <= 8; i++) { %>
                <option
                    value="<%= i %>"
                    <%= String(semester || '') === String(i) ? 'selected' : '' %>
                >
                    <%= i %>
                </option>
            <% } %>
        </select>
    </div>

    <button type="submit">Применить</button>
    <a href="/courses">Сбросить</a>
</form>

<% if (courses.length === 0) { %>

    <p>Курсы не найдены</p>

<% } else { %>

    <table>
        <thead>
            <tr>
                <th>Название</th>
                <th>Преподаватель</th>
                <th>Кредиты</th>
                <th>Семестр</th>
                <th>Действия</th>
            </tr>
        </thead>

        <tbody>
            <% courses.forEach(function(course) { %>
                <tr>
                    <td>
                        <%= course.title %>
                    </td>

                    <td>
                        <%= course.teacher %>
                    </td>

                    <td>
                        <%= course.credits %>
                    </td>

                    <td>
                        <%= course.semester %>
                    </td>

                    <td>
                        <a href="/courses/<%= course.id %>">
                            Просмотр
                        </a>

                        <a href="/courses/<%= course.id %>/edit">
                            Редактировать
                        </a>

                        <form
                            action="/courses/<%= course.id %>/delete"
                            method="POST"
                            style="display: inline;"
                            onsubmit="return confirm('Удалить этот курс?')"
                        >
                            <button type="submit">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

<% } %>

<%- include('../partials/footer') %>