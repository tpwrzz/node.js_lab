<%- include('../partials/header', { title }) %>

<h1>Редактировать курс</h1>

<form action="/courses/<%= course.id %>/edit" method="POST">

    <div>
        <label for="title">Название курса:</label>
        <input
            type="text"
            id="title"
            name="title"
            value="<%= course.title %>"
            required
        >
    </div>

    <div>
        <label for="teacherId">Преподаватель:</label>

        <select id="teacherId" name="teacherId" required>
            <option value="">Выберите преподавателя</option>

            <% teachers.forEach(teacher => { %>
                <option
                    value="<%= teacher.id %>"
                    <%= Number(course.teacherId) === Number(teacher.id) ? 'selected' : '' %>
                >
                    <%= teacher.name %>
                </option>
            <% }) %>
        </select>
    </div>

    <div>
        <label for="credits">Количество кредитов:</label>
        <input
            type="number"
            id="credits"
            name="credits"
            min="1"
            value="<%= course.credits %>"
            required
        >
    </div>

    <div>
        <label for="semester">Семестр:</label>
        <input
            type="number"
            id="semester"
            name="semester"
            min="1"
            max="8"
            value="<%= course.semester %>"
            required
        >
    </div>

    <div>
        <label for="description">Описание:</label>
        <textarea
            id="description"
            name="description"
            required
        ><%= course.description %></textarea>
    </div>

    <button type="submit">Сохранить изменения</button>
</form>

<a href="/courses/<%= course.id %>">Отмена</a>

<%- include('../partials/footer') %>