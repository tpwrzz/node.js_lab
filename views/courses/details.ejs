<%- include('../partials/header') %>

<h1><%= course.title %></h1>

<div class="course-details">
    <p>
        <strong>Преподаватель:</strong>
        <%= course.teacher %>
    </p>

    <p>
        <strong>Количество кредитов:</strong>
        <%= course.credits %>
    </p>

    <p>
        <strong>Семестр:</strong>
        <%= course.semester %>
    </p>

    <p>
        <strong>Описание:</strong>
        <%= course.description %>
    </p>
</div>

<div class="actions">
    <a href="/courses" class="button">Назад к списку</a>

    <a href="/courses/<%= course.id %>/edit" class="button">
        Редактировать
    </a>

    <form
        action="/courses/<%= course.id %>/delete"
        method="POST"
        style="display: inline;"
        onsubmit="return confirm('Вы уверены, что хотите удалить этот курс?');"
    >
        <button type="submit" class="button delete-button">
            Удалить
        </button>
    </form>
</div>

<%- include('../partials/footer') %>