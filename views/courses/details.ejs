<%- include('../partials/header', { title }) %>

<h1><%= course.title %></h1>

<p>
    <strong>Кредиты:</strong>
    <%= course.credits %>
</p>

<p>
    <strong>Семестр:</strong>
    <%= course.semester %>
</p>

<p>
    <strong>Описание:</strong>
    <%= course.description %>
</p>

<h2>Преподаватель</h2>

<p>
    <strong>Имя:</strong>
    <%= course.Teacher.name %>
</p>

<p>
    <strong>Email:</strong>
    <%= course.Teacher.email %>
</p>

<p>
    <strong>Кафедра:</strong>
    <%= course.Teacher.department %>
</p>

<a href="/courses/<%= course.id %>/edit">
    Редактировать
</a>

<form
    action="/courses/<%= course.id %>/delete"
    method="POST"
    style="display: inline;"
    onsubmit="return confirm('Вы действительно хотите удалить этот курс?');"
>
    <button type="submit">Удалить</button>
</form>

<a href="/courses">Назад к курсам</a>

<%- include('../partials/footer') %>