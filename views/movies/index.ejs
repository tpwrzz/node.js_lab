<%- include('../partials/header') %>

    <h1>Каталог фильмов</h1>

    <a href="/movies/new" class="button">Добавить новый фильм</a>

    <h2>Поиск и фильтрация</h2>

    <form action="/movies" method="GET" class="filter-form">
        <div>
            <label for="search">Поиск:</label>
            <input type="text" id="search" name="search" value="<%= search || '' %>" placeholder="Жанр">
        </div>


        <button type="submit">Применить</button>
        <a href="/movies">Сбросить</a>
    </form>

    <% if (movies.length===0) { %>
        <p>Фильмы не найдены.</p>
        <% } else { %>

            <table>
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Жанр</th>
                        <th>Год</th>
                        <th>Режиссёр</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    <% movies.forEach(function(movie) { %>
                        <tr>
                            <td>
                                <%= movie.title %>
                            </td>
                            <td>
                                <%= movie.genre %>
                            </td>
                            <td>
                                <%= movie.year %>
                            </td>
                            <td>
                                <%= movie.director %>
                            </td>
                            <td>
                                <a href="/movies/<%= movie.id %>/edit">
                                    Редактировать
                                </a>

                                <form action="/api/movies/<%= movie.id %>" method="POST" class="delete-form"
                                    style="display: inline;">
                                    <button type="submit">Удалить</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
                <script>
                    document.querySelectorAll('.delete-form').forEach(form => {
                        form.addEventListener('submit', async function (event) {
                            event.preventDefault();
                            event.stopPropagation();

                            if (!confirm('Удалить этот фильм?')) {
                                return;
                            }

                            const response = await fetch(event.currentTarget.action, {
                                method: 'DELETE'
                            });

                            if (response.ok) {
                                window.location.href = '/movies';
                            } else {
                                alert('Не удалось удалить фильм');
                            }
                        });
                    });
                </script>
            </table>

            <% } %>

                <%- include('../partials/footer') %>