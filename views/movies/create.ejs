<%- include('../partials/header') %>

<h1>Добавить новый фильм</h1>

<% if (errors && errors.length > 0) { %>
    <div class="errors">
        <ul>
            <% errors.forEach(function(error) { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form action="/api/movies" method="POST" class="movie-form">
    <div>
        <label for="title">Название фильма:</label>
        <input
            type="text"
            id="title"
            name="title"
            value="<%= formData?.title || '' %>"
        >
    </div>

    <div>
        <label for="genre">Жанр:</label>
        <input
            type="text"
            id="genre"
            name="genre"
            value="<%= formData?.genre || '' %>"
        >
    </div>

    <div>
        <label for="year">Год выпуска:</label>
        <input
            type="number"
            id="year"
            name="year"
            min="1888"
            max="2026"
            value="<%= formData?.year || '' %>"
        >
    </div>

    <div>
        <label for="director">Режиссер:</label>
        <input
            type="text"
            id="director"
            name="director"
            value="<%= formData?.director || '' %>"
        >
    </div>

    <button type="submit">
        Добавить фильм
    </button>

    <a href="/movies">
        Отмена
    </a>

</form>

<%- include('../partials/footer') %>