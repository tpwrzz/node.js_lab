<%- include('../partials/header') %>

<h1>Редактировать фильм</h1>

<% if (errors && errors.length > 0) { %>
    <div class="errors">
        <ul>
            <% errors.forEach(function(error) { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form id="edit-movie-form" action="/api/movies/<%= movie.id %>" method="POST" class="movie-form">
    <div>
        <label for="title">Название фильма:</label>
        <input
            type="text"
            id="title"
            name="title"
            value="<%= formData?.title ?? movie.title ?? '' %>"
            required
        >
    </div>

    <div>
        <label for="genre">Жанр:</label>
        <input
            type="text"
            id="genre"
            name="genre"
            value="<%= formData?.genre ?? movie.genre ?? '' %>"
            required
        >
    </div>

    <div>
        <label for="year">Год выпуска:</label>
        <input
            type="number"
            id="year"
            name="year"
            min="1888"
            max="2026"
            value="<%= formData?.year ?? movie.year ?? '' %>"
            required
        >
    </div>

    <div>
        <label for="director">Режиссёр:</label>
        <input
            type="text"
            id="director"
            name="director"
            value="<%= formData?.director ?? movie.director ?? '' %>"
            required
        >
    </div>

    <button type="submit">Сохранить изменения</button>

    <a href="/movies/<%= movie.id %>">Отмена</a>
<script>
document.getElementById('edit-movie-form').addEventListener('submit', async function (event) {
    event.preventDefault();

    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());

    const response = await fetch(this.action, {
        method: 'PATCH',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    });

    if (response.ok) {
        window.location.href = '/movies';
    } else {
        console.error('Failed to update movie:', response.statusText);
        alert('Не удалось обновить фильм');
    }
});
</script>
</form>

<%- include('../partials/footer') %>