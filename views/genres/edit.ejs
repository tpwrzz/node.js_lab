<%- include('../partials/header', { title }) %>

    <h1>Редактировать жанр</h1>

    <form action="/genres/<%= genre.id %>/edit" method="POST">
        <% if (errors && errors.length> 0) { %>
            <ul class="validation-errors">
                <% errors.forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <div>
                    <label for="name">Название жанра:</label>
                    <input type="text" id="name" name="name" value="<%= genre.name || '' %>" minlength="2"
                        maxlength="100" autocomplete="off" required>
                </div>

                <button type="submit">Сохранить изменения</button>
    </form>

    <p><a href="/genres/<%= genre.id %>">Отмена</a></p>

    <%- include('../partials/footer') %>