<%- include('../partials/header', { title }) %>

    <h1>Редактировать автора</h1>

    <form action="/authors/<%= author.id %>/edit" method="POST">
        <% if (errors && errors.length> 0) { %>
            <ul class="validation-errors">
                <% errors.forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <div>
                    <label for="name">Имя автора:</label>
                    <input type="text" id="name" name="name" value="<%= author.name %>" required>
                </div>

                <div>
                    <label for="born">Год рождения:</label>
                    <input type="number" id="born" name="born" min="1" max="<%= new Date().getFullYear() %>"
                        value="<%= author.born || '' %>">
                </div>

                <div>
                    <label for="deceased">Год смерти:</label>
                    <input type="number" id="deceased" name="deceased" min="1" max="<%= new Date().getFullYear() %>"
                        value="<%= author.deceased || '' %>">
                </div>

                <button type="submit">Сохранить изменения</button>
    </form>

    <p><a href="/authors/<%= author.id %>">Отмена</a></p>

    <%- include('../partials/footer') %>